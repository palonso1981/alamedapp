rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAlamedaDevOwner() {
      return bucket == "cdalameda-dev.firebasestorage.app"
        && request.auth != null
        && resource.metadata.ownerUid == request.auth.uid;
    }

    // DEV mínimo: solo CDA y solo el uid anónimo propietario del objeto.
    // Producción deberá exigir autorización real de club/usuario/rol.
    match /clubs/cd-alameda/players/{playerId}/{versionFile} {
      allow read: if isAlamedaDevOwner();
      allow create: if bucket == "cdalameda-dev.firebasestorage.app"
        && request.auth != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && request.resource.metadata.clubId == "cd-alameda"
        && request.resource.metadata.playerId == playerId
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow update: if isAlamedaDevOwner()
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && request.resource.metadata.clubId == "cd-alameda"
        && request.resource.metadata.playerId == playerId
        && request.resource.metadata.ownerUid == request.auth.uid;
      allow delete: if isAlamedaDevOwner();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
