# Firebase DEV only. Copy to .env.local; never commit real values.
NEXT_PUBLIC_FIREBASE_ENV=dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DEV_ANONYMOUS_AUTH=true

# Optional local emulators.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
NEXT_PUBLIC_FIREBASE_EMULATOR_AUTH_PORT=9099

# Optional diagnostics; disabled by default.
NEXT_PUBLIC_SYNC_DEBUG=false
