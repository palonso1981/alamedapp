# Plantilla RC3-A. Sustituir todos los placeholders al crear PROD.
NEXT_PUBLIC_APP_ENV=prod
NEXT_PUBLIC_FIREBASE_ENV=prod
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_PROD_PROJECT_ID
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_PUBLIC_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROD_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_PROD_APP_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_PROD_SENDER_ID
NEXT_PUBLIC_FIREBASE_ANONYMOUS_AUTH=true
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# Cloudinary PROD debe ser distinto del cloud/preset DEV.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_PROD_CLOUD
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=REPLACE_WITH_PROD_UNSIGNED_PRESET
