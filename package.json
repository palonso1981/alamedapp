{
  "name": "alamedapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "access:bootstrap": "node scripts/generate-access-bootstrap.mjs",
    "data:compile": "tsc -p tsconfig.data.json",
    "data:preflight": "npm run data:compile --silent && node .data-build/scripts/dataCli.js preflight",
    "data:backup": "npm run data:compile --silent && node .data-build/scripts/dataCli.js backup",
    "data:validate": "npm run data:compile --silent && node .data-build/scripts/dataCli.js validate",
    "data:restore": "npm run data:compile --silent && node .data-build/scripts/dataCli.js restore",
    "data:export-match": "npm run data:compile --silent && node .data-build/scripts/dataCli.js export-match",
    "data:import-match": "npm run data:compile --silent && node .data-build/scripts/dataCli.js import-match",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/lib/matchEngine.test.js .test-build/lib/captureOrientation.test.js .test-build/lib/captureLease.test.js .test-build/lib/dataPortability.test.js .test-build/lib/dashboardAnalytics.test.js .test-build/lib/dashboardAnalysis.test.js .test-build/lib/dashboardV2.test.js .test-build/lib/videoIndex.test.js .test-build/lib/videoReview.test.js .test-build/lib/access/accessDomain.test.js .test-build/lib/access/firestoreRules.test.js .test-build/lib/sync/sync.test.js .test-build/lib/roster.test.js"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
